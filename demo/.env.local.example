# Environment variables — copy this to .env.local and fill in your values
# NEVER commit .env.local to version control

# Gemini API key from Google AI Studio
# Get yours at: https://aistudio.google.com/app/apikey
# NOTE: Prefix with VITE_ so Vite exposes it to the browser (import.meta.env)
VITE_GEMINI_API_KEY=
